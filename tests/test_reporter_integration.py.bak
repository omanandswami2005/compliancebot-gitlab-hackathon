"""Integration-style tests for the compliance reporter agent."""

import json
import sys
from pathlib import Path
from unittest.mock import patch, MagicMock

import pytest

sys.path.insert(0, str(Path(__file__).parent.parent / "src"))

from agents.reporter import (
    generate_mr_comment,
    should_post_comment,
    findings_for_issues,
    build_issue_body,
    generate_report,
    REMEDIATION_TIMELINES,
)


# ---------------------------------------------------------------------------
# MR comment generation
# ---------------------------------------------------------------------------


class TestGenerateMRComment:
    """Test MR comment Markdown generation."""

    def test_badge_brightgreen_for_passing_score(self):
        comment = generate_mr_comment([], 90)
        assert "brightgreen" in comment

    def test_badge_yellow_for_warning_score(self):
        comment = generate_mr_comment([], 75)
        assert "yellow" in comment

    def test_badge_red_for_failing_score(self):
        comment = generate_mr_comment([], 60)
        assert "red" in comment

    def test_includes_score_text(self):
        comment = generate_mr_comment([], 42)
        assert "42/100" in comment

    def test_includes_findings_count(self):
        findings = [{"severity": "high", "description": "A"}]
        comment = generate_mr_comment(findings, 85)
        assert "Findings: 1" in comment

    def test_includes_findings_table(self):
        findings = [
            {"severity": "critical", "description": "Bad secret", "control_id": "SOC2-CC6.1"},
        ]
        comment = generate_mr_comment(findings, 50)
        assert "CRITICAL" in comment
        assert "Bad secret" in comment
        assert "SOC2-CC6.1" in comment

    def test_passing_status_line(self):
        comment = generate_mr_comment([], 85)
        assert "meets compliance requirements" in comment

    def test_failing_status_line(self):
        comment = generate_mr_comment([], 84)
        assert "Review compliance findings" in comment

    def test_frameworks_shown(self):
        comment = generate_mr_comment([], 50, frameworks=["SOC2", "PCI-DSS"])
        assert "SOC2" in comment
        assert "PCI-DSS" in comment


# ---------------------------------------------------------------------------
# Comment posting threshold
# ---------------------------------------------------------------------------


class TestShouldPostComment:
    def test_posts_when_below_85(self):
        assert should_post_comment(84) is True
        assert should_post_comment(0) is True

    def test_no_post_at_85_or_above(self):
        assert should_post_comment(85) is False
        assert should_post_comment(100) is False


# ---------------------------------------------------------------------------
# Issue filtering
# ---------------------------------------------------------------------------


class TestFindingsForIssues:
    def test_includes_critical_high_medium(self):
        findings = [
            {"severity": "critical"},
            {"severity": "high"},
            {"severity": "medium"},
        ]
        assert len(findings_for_issues(findings)) == 3

    def test_excludes_low(self):
        findings = [{"severity": "low"}, {"severity": "info"}]
        assert findings_for_issues(findings) == []

    def test_mixed(self):
        findings = [
            {"severity": "critical"},
            {"severity": "low"},
            {"severity": "medium"},
            {"severity": "low"},
        ]
        result = findings_for_issues(findings)
        assert len(result) == 2
        assert all(f["severity"] in ("critical", "medium") for f in result)


# ---------------------------------------------------------------------------
# Issue body builder
# ---------------------------------------------------------------------------


class TestBuildIssueBody:
    def test_title_contains_severity_and_description(self):
        finding = {"severity": "high", "description": "Weak cipher"}
        payload = build_issue_body(finding, 70)
        assert "[HIGH]" in payload["title"]
        assert "Weak cipher" in payload["title"]

    def test_labels_include_severity(self):
        finding = {"severity": "critical", "description": "x"}
        payload = build_issue_body(finding, 50)
        assert "compliance" in payload["labels"]
        assert "severity::critical" in payload["labels"]

    def test_body_contains_timeline(self):
        finding = {"severity": "medium", "description": "x"}
        payload = build_issue_body(finding, 80)
        assert "30 days" in payload["description"]

    def test_control_id_from_control_ids_list(self):
        finding = {"severity": "high", "description": "x", "control_ids": ["SOC2-CC6.1"]}
        payload = build_issue_body(finding, 70)
        assert "SOC2-CC6.1" in payload["description"]


# ---------------------------------------------------------------------------
# Full generate_report (dry-run, no GitLab API)
# ---------------------------------------------------------------------------


class TestGenerateReportDryRun:
    """When project_id is None the reporter skips API calls."""

    def test_returns_comment_markdown(self):
        result = generate_report([], 100)
        assert "comment_markdown" in result
        assert "100/100" in result["comment_markdown"]

    def test_no_api_calls_without_project_id(self):
        result = generate_report(
            [{"severity": "high", "description": "x"}], 70
        )
        assert result["comment_posted"] is False
        assert result["issues_created"] == 0

    def test_issue_payloads_built_for_qualifying_findings(self):
        findings = [
            {"severity": "critical", "description": "A"},
            {"severity": "low", "description": "B"},
        ]
        result = generate_report(findings, 50)
        # Only critical qualifies
        assert len(result["issue_payloads"]) == 1
        assert result["issue_payloads"][0]["title"].startswith("🔒 [CRITICAL]")


# ---------------------------------------------------------------------------
# Full generate_report with mocked GitLab API
# ---------------------------------------------------------------------------


class TestGenerateReportWithAPI:
    """Verify API calls when project_id is provided."""

    @patch("src.utils.gitlab_api.create_compliance_issue")
    @patch("src.utils.gitlab_api.post_compliance_comment")
    def test_posts_comment_when_score_below_85(self, mock_post, mock_issue):
        generate_report(
            [{"severity": "high", "description": "x"}],
            compliance_score=70,
            project_id="group/project",
            mr_iid=42,
        )
        mock_post.assert_called_once()

    @patch("src.utils.gitlab_api.create_compliance_issue")
    @patch("src.utils.gitlab_api.post_compliance_comment")
    def test_no_comment_when_score_at_85(self, mock_post, mock_issue):
        generate_report(
            [],
            compliance_score=85,
            project_id="group/project",
            mr_iid=42,
        )
        mock_post.assert_not_called()

    @patch("src.utils.gitlab_api.create_compliance_issue")
    @patch("src.utils.gitlab_api.post_compliance_comment")
    def test_creates_issues_for_qualifying_findings(self, mock_post, mock_issue):
        findings = [
            {"severity": "critical", "description": "A"},
            {"severity": "high", "description": "B"},
            {"severity": "medium", "description": "C"},
            {"severity": "low", "description": "D"},
        ]
        result = generate_report(
            findings,
            compliance_score=30,
            project_id="group/project",
            mr_iid=1,
        )
        # critical + high + medium = 3 issues
        assert mock_issue.call_count == 3
        assert result["issues_created"] == 3

    @patch("src.utils.gitlab_api.create_compliance_issue")
    @patch("src.utils.gitlab_api.post_compliance_comment")
    def test_no_issues_for_all_low(self, mock_post, mock_issue):
        findings = [
            {"severity": "low", "description": "D"},
            {"severity": "low", "description": "E"},
        ]
        result = generate_report(
            findings,
            compliance_score=90,
            project_id="group/project",
            mr_iid=1,
        )
        mock_issue.assert_not_called()
        assert result["issues_created"] == 0
